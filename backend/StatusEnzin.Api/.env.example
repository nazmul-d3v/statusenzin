# PostgreSQL Database Connection String (STRICTLY REQUIRED - No SQLite fallback)
DATABASE_URL=Host=localhost;Port=5432;Database=statusenzin_dev;Username=postgres;Password=your_postgres_password

# Server & Client URLs
API_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Platform Super Admin Configuration
SUPER_ADMIN_EMAIL=admin@statusenzin.me
SUPER_ADMIN_PASSWORD=Admin123!
SUPER_ADMIN_FULL_NAME=Alex Mercer
SUPER_ADMIN_TENANT_NAME=Acme Cloud Infrastructure

# JWT Authentication Configuration
JWT_KEY=StatusEnzinSuperSecretKeyForJWTAuth2026!MustBeVeryLong
JWT_ISSUER=StatusEnzin
JWT_AUDIENCE=StatusEnzinApp

# Stripe Configuration
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly_test
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_business_monthly_test
# Annual price IDs (optional per plan; falls back to the monthly price ID if unset)
STRIPE_PRO_ANNUAL_PRICE_ID=price_pro_annual_test
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_business_annual_test
# Stripe coupon IDs for the supported promo codes (create matching coupons in the Stripe dashboard)
STRIPE_COUPON_SAVE20=save20
STRIPE_COUPON_WELCOME20=welcome20
STRIPE_COUPON_PROMO10=promo10
STRIPE_COUPON_HALFPRICE=halfprice

# Resend / Email Configuration
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=alerts@statusenzin.me
# Optional: override template ids if your Resend dashboard assigned UUIDs instead of names.
# Keys are RESEND_TEMPLATE_<NAME_UPPER_SNAKE> e.g. RESEND_TEMPLATE_INCIDENT_UPDATE=<template_uuid>

# Monitoring Engine Configuration
MONITOR_CHECK_INTERVAL_SECONDS=15
MONITOR_HTTP_TIMEOUT_SECONDS=15

# Seed demo content (Acme status page, monitors, 90-day check history, incidents).
# Defaults: true in Development, false everywhere else. Override here if needed.
# SEED_DEMO_DATA=true