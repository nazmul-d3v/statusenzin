# =============================================================================
# StatusEnzin — Environment Configuration
# Copy this file to .env and fill in real values before running docker compose up
# =============================================================================

# ---------- Database ----------
DB_USER=statusenzin
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_NAME=statusenzin

# ---------- API Port (host-mapped) ----------
API_PORT=8080

# ---------- Web Port (host-mapped) ----------
WEB_PORT=3000

# ---------- Frontend build arg (public API URL the browser calls) ----------
# Set to your actual API domain for production builds
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ---------- JWT Authentication ----------
# Generate a long random string, e.g. openssl rand -hex 32
JWT_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ISSUER=StatusEnzin
JWT_AUDIENCE=StatusEnzinApp

# ---------- Platform Super Admin ----------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_FULL_NAME=Admin
ADMIN_TENANT_NAME=Default

# ---------- CORS ----------
ALLOWED_ORIGINS=https://app.yourdomain.com

# ---------- Stripe (leave empty to use mock mode) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_BUSINESS_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_BUSINESS_ANNUAL_PRICE_ID=
STRIPE_COUPON_SAVE20=
STRIPE_COUPON_WELCOME20=
STRIPE_COUPON_PROMO10=
STRIPE_COUPON_HALFPRICE=

# ---------- Resend / Email (leave empty to log to console) ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@yourdomain.com

# ---------- Monitor Engine ----------
MONITOR_CHECK_INTERVAL_SECONDS=30
MONITOR_HTTP_TIMEOUT_SECONDS=15

# ---------- Seeding ----------
SEED_DEMO_DATA=false
